# Copy this file to .env and replace the placeholder key.
# .env is gitignored. Never commit a real API key.

# Required. OpenAI secret key used by the Python SDK.
OPENAI_API_KEY=your-api-key-here

# Required. Any current OpenAI model that supports structured outputs.
# gpt-6-astra is the current default for new projects; override it to use
# another structured-output model without changing application code.
OPENAI_MODEL=gpt-6-astra
